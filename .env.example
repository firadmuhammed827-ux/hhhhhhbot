# انسخ هذا الملف إلى .env واملأ القيم (لا تَرفع .env إلى GitHub)
# توكن البوت من BotFather
TOKEN=123456789:AA...your-telegram-bot-token

# مفتاح الذكاء الاصطناعي (بوابة متوافقة مع OpenAI)
OPENAI_API_KEY=sk-...

# عنوان البوابة التي تخدم نماذج gemini-2.5-flash / gpt-4.1-nano
# (مطلوب لأن النماذج ليست من OpenAI الرسمي)
OPENAI_BASE_URL=https://your-gateway.example/v1
